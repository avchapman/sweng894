generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STAFF
  PARENT
}

model Organization {
  id                 String              @id @default(uuid())
  name               String              @unique
  users              User[]
  childProfiles      ChildProfile[]
  enrollmentRequests EnrollmentRequest[]
  scheduleEntries    ScheduleEntry[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model User {
  id             String       @id @default(uuid())
  firstName      String
  lastName       String
  email          String       @unique
  passwordHash   String
  role           UserRole
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  childLinks     ParentChildLink[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model ScheduleEntry {
  id             String               @id @default(uuid())
  title          String
  description    String?
  startTime      DateTime
  endTime        DateTime
  location       String?
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id])
  assignments    ScheduleAssignment[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([organizationId, startTime])
}

model ScheduleAssignment {
  scheduleEntryId String
  childProfileId  String
  scheduleEntry   ScheduleEntry @relation(fields: [scheduleEntryId], references: [id], onDelete: Cascade)
  childProfile    ChildProfile  @relation(fields: [childProfileId], references: [id], onDelete: Cascade)

  @@id([scheduleEntryId, childProfileId])
  @@index([childProfileId])
}

model ChildProfile {
  id                  String               @id @default(uuid())
  firstName           String
  lastName            String
  dateOfBirth         DateTime?
  notes               String?
  archived            Boolean              @default(false)
  organizationId      String
  organization        Organization         @relation(fields: [organizationId], references: [id])
  scheduleAssignments ScheduleAssignment[]
  parentLinks         ParentChildLink[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model ParentChildLink {
  parentId       String
  childProfileId String
  parent         User         @relation(fields: [parentId], references: [id], onDelete: Cascade)
  childProfile   ChildProfile @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@id([parentId, childProfileId])
  @@index([childProfileId])
}

model EnrollmentRequest {
  id             String        @id @default(uuid())
  parentName     String
  email          String
  phone          String?
  childName      String
  childAge       Int?
  message        String?
  status         String        @default("NEW")
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}
